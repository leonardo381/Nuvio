# Nuvio cms5 public runtime local compose env.
# VITE_* values are exposed to the browser and must never contain secrets.

VITE_PB_URL=http://localhost:8090
VITE_NUVIO_BACKEND_URL=http://localhost:8090
VITE_PUBLIC_SITE_BASE_URL=http://localhost:3000
VITE_CMS_PREVIEW_PARENT_ORIGIN=http://localhost:8090

# Server-only values used by the Node runtime inside Docker.
NUVIO_BACKEND_URL=http://nuvio-backoffice:8090
PB_URL=http://nuvio-backoffice:8090