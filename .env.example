# Nuvio backend env template
# Keep real values only in local .env files (never commit secrets).

# PocketBase / service auth (server-only)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
PB_SERVICE_EMAIL=
PB_SERVICE_PASSWORD=
PB_URL=

# Email provider (server-only)
NUVIO_RESEND_API_KEY=
RESEND_API_KEY=
NUVIO_RESEND_FROM=
RESEND_FROM=
NUVIO_RESEND_FROM_EMAIL=
RESEND_FROM_EMAIL=

# Reports integration (server-only)
NUVIO_UMAMI_API_URL=
NUVIO_UMAMI_API_KEY=
NUVIO_UMAMI_USERNAME=
NUVIO_UMAMI_PASSWORD=

# Reviews integration (server-only)
NUVIO_GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_KEY=

# Public URLs / operational tooling
NUVIO_PUBLIC_BASE_URL=
NUVIO_QA_BASE_URL=
NUVIO_ALLOW_DEV_RESET=

# CORS (server-only)
# Explicitly set allowed origins for production. Separate with spaces, commas or semicolons.
# Example: https://admin.your-domain.example.com https://www.your-site.example.com
NUVIO_CORS_ALLOWED_ORIGINS=

# Preview/CSP integration (server-only)
# Space-separated iframe origins the backoffice dashboard may load for CMS preview.
# Dev example: http://localhost:5173 http://127.0.0.1:5173
# Prod example: https://www.your-site.example.com
NUVIO_CMS_PREVIEW_FRAME_SRC=
