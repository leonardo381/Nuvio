# Backoffice UI env template
# WARNING: Any variable with VITE_ prefix is exposed to the browser bundle.

# Core backend URL for PocketBase API calls
VITE_PB_BACKEND_URL=https://your-backend.example.com

# Public site URL for CMS preview/open-site links. Browser-exposed and needed at UI build time.
VITE_PUBLIC_SITE_BASE_URL=https://www.your-site.example.com

# Public docs/links shown in the UI
VITE_PB_DOCS_URL=https://pocketbase.io/docs
VITE_PB_RELEASES=https://github.com/pocketbase/pocketbase/releases
VITE_PB_VERSION=dev
VITE_PB_JS_SDK_URL=https://github.com/pocketbase/js-sdk
VITE_PB_DART_SDK_URL=https://github.com/pocketbase/dart-sdk
VITE_PB_RULES_SYNTAX_DOCS=https://pocketbase.io/docs/api-rules-and-filters
VITE_PB_OAUTH2_EXAMPLE=https://github.com/pocketbase/pocketbase/discussions
VITE_PB_FILE_UPLOAD_DOCS=https://pocketbase.io/docs/files-handling
VITE_PB_MFA_DOCS=https://pocketbase.io/docs/authentication
VITE_PB_PROTECTED_FILE_DOCS=https://pocketbase.io/docs/files-handling
